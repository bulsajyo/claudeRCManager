<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudeRcManager</AssemblyName>
    <RootNamespace>ClaudeRcManager</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.1</Version>
    <ApplicationIcon>icon\app.ico</ApplicationIcon>

    <!-- `dotnet publish -c Release -o dist` 한 번으로 .NET 런타임까지 들어 있는 exe 하나만 나오게 한다 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 창/트레이 아이콘도 exe 아이콘과 같은 파일을 쓴다 (icon\make-icon.ps1 로 생성) -->
    <EmbeddedResource Include="icon\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
